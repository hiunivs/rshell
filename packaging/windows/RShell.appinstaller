<AppInstaller
    xmlns="http://schemas.microsoft.com/appx/appinstaller/2021"
    Version="__VERSION__"
    Uri="__APPINSTALLER_URL__">
    <MainBundle
        Name="__PACKAGE_NAME__"
        Publisher="__PUBLISHER__"
        Version="__VERSION__"
        Uri="__BUNDLE_URL__" />
